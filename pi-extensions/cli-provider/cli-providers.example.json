{
	"providers": [
		{
			"id": "gemini-cli",
			"name": "Gemini CLI",
			"command": "gemini",
			"args": ["--model", "{model}", "--output-format", "stream-json"],
			"prompt": "stdin",
			"output": "jsonl",
			"jsonl": {
				"text": { "match": { "type": "message", "role": "assistant" }, "path": "content" },
				"usage": {
					"match": { "type": "result" },
					"input": "stats.input_tokens",
					"output": "stats.output_tokens",
					"total": "stats.total_tokens"
				},
				"error": { "match": { "type": "error" }, "path": "message" }
			},
			"tools": "prompted",
			"models": [
				{
					"id": "gemini-2.5-pro",
					"name": "Gemini 2.5 Pro (CLI)",
					"contextWindow": 1048576,
					"maxTokens": 65536
				},
				{
					"id": "gemini-2.5-flash",
					"name": "Gemini 2.5 Flash (CLI)",
					"contextWindow": 1048576,
					"maxTokens": 65536
				}
			]
		}
	]
}
